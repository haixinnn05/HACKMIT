# Trial Passport configuration. Copy to .env.local. No key is required to run.

# Optional. Without it the app still works end to end: study briefs are
# assembled deterministically from the registry records themselves, and the UI
# says which path produced the text.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
TRIAL_PASSPORT_MODEL=claude-sonnet-5

# Optional. Defaults to data/trial-passport.db, created and seeded on first run.
TRIAL_PASSPORT_DB=
