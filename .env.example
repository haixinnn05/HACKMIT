# Mozaic configuration. Copy to .env.local, which git ignores. No key is required to run:
# without one, study briefs are assembled by rule from the registry records, and the
# interface says which path produced the text.

# Option A: any OpenAI-compatible endpoint (OpenAI, or a hosted gateway).
# Both the key and the base URL are required. A key on its own is never sent anywhere.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional. A quicker model for moments when someone is waiting on an answer.
LLM_MODEL_FAST=

# Meta Model API:  LLM_BASE_URL=https://api.meta.ai/v1   LLM_MODEL=muse-spark-1.3   LLM_MODEL_FAST=muse-spark-1.2
# OpenAI:          LLM_BASE_URL=https://api.openai.com/v1

# Option B: Anthropic.
ANTHROPIC_API_KEY=
MOZAIC_MODEL=claude-sonnet-5

# Optional. Defaults to data/mozaic.db, created and seeded on first run.
MOZAIC_DB=

# Optional. Identifies this app to OpenAlex, which asks polite clients to do so.
OPENALEX_MAILTO=

# Search backend (optional). Without these the app uses SQLite FTS5, which needs no setup.
# The app loads the index by itself on first use. npm run es:index rebuilds and verifies it.
# ELASTICSEARCH_URL=https://your-deployment.es.region.cloud.es.io
# ELASTICSEARCH_API_KEY=
